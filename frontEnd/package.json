{
  "name": "m4-research-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8872",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8872",
    "test:quality": "vite build --ssr src/QualityStrategies.tsx --outDir .quality-test-build && node --test tests/quality-strategies.test.mjs",
    "test:history": "vite build --ssr src/StrategyBacktestHistory.tsx --outDir .quality-test-build/history && node --test tests/backtest-history.test.mjs",
    "test:strategy-exit": "vite build --ssr src/StrategyBacktest.tsx --outDir .quality-test-build/strategy-exit && node --test tests/strategy-exit.test.mjs",
    "test:chart-range": "vite build --ssr tests/chart-range-entry.ts --outDir .quality-test-build/chart-range && node --test tests/chart-time-range.test.mjs",
    "test:data-progress": "vite build --ssr src/DataUpdateProgress.tsx --outDir .quality-test-build/data-progress && node --test tests/data-progress.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "react-test-renderer": "^19.3.0"
  }
}
